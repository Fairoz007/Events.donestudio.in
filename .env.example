# Application (safe public value)
NEXT_PUBLIC_APP_URL=https://events.donestudio.in

# Convex frontend connection
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex CLI deployment name, created by `npx convex dev`
CONVEX_DEPLOYMENT=

# Clerk frontend and Worker runtime
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Convex production environment (set with the Convex CLI, not in Cloudflare)
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=
ADMIN_BOOTSTRAP_SECRET=abc123

# Optional: only when a dedicated game WebSocket service exists
NEXT_PUBLIC_GAME_WS_URL=
